{
  // Migración gradual a TypeScript: conviven .jsx y .tsx.
  // `strict` está apagado a propósito mientras queden pantallas en JSX; se
  // enciende cuando ya no quede ninguna. Las pantallas nuevas se escriben
  // tipadas igual, para que ese día no haya nada que corregir.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@src/*": ["src/*"] }
  },
  "include": ["src"]
}
